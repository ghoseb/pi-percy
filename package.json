{
  "name": "pi-percy",
  "version": "1.1.2",
  "description": "Pi extension that lets the agent compact its own context in place: it trims old tool outputs and replaces old messages with short notes, and can search and recall the originals",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "context",
    "compaction",
    "llm",
    "agent"
  ],
  "license": "MIT",
  "author": "Baishampayan Ghose <b.ghose@gmail.com>",
  "homepage": "https://github.com/ghoseb/pi-percy#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ghoseb/pi-percy.git"
  },
  "bugs": {
    "url": "https://github.com/ghoseb/pi-percy/issues"
  },
  "type": "module",
  "files": [
    "extensions/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.6.0",
    "pnpm": ">=10.33.0"
  },
  "pi": {
    "extensions": [
      "./extensions/percy"
    ]
  },
  "scripts": {
    "test": "node --test 'test/**/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fix": "pnpm run lint:fix && pnpm run format",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test",
    "release": "node scripts/release.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.10.2",
    "git-cliff": "2.14.2",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
